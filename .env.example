# Copy this file to .env, then add your API key.
# The experiments read these variables first (OPENAI_* takes priority):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openlux.ai/v1
OPENAI_MODEL=gpt-5.4-nano
OPENAI_REASONING_EFFORT=low

# NVIDIA NIM fallback (used only when the OPENAI_* variables above are unset):
# NVIDIA_API_KEY=
# NVIDIA_MODEL=openai/gpt-oss-120b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
