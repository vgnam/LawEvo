<?xml version="1.0"?>
<robot name="lawevo_drawer">
  <link name="cabinet">
    <inertial><mass value="1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 -0.025"/><geometry><box size="0.24 0.22 0.02"/></geometry></visual>
    <collision><origin xyz="0 0 -0.025"/><geometry><box size="0.24 0.22 0.02"/></geometry></collision>
  </link>
  <link name="drawer">
    <inertial><mass value="0.25"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
    <visual><geometry><box size="0.20 0.18 0.02"/></geometry><material name="wood"><color rgba="0.65 0.4 0.2 1"/></material></visual>
    <collision><geometry><box size="0.20 0.18 0.02"/></geometry></collision>
    <visual><origin xyz="-0.13 0 0.04"/><geometry><box size="0.04 0.025 0.02"/></geometry></visual>
    <collision><origin xyz="-0.13 0 0.04"/><geometry><box size="0.04 0.025 0.02"/></geometry></collision>
    <visual><origin xyz="-0.10 0 0.02"/><geometry><box size="0.02 0.02 0.04"/></geometry></visual>
    <collision><origin xyz="-0.10 0 0.02"/><geometry><box size="0.02 0.02 0.04"/></geometry></collision>
  </link>
  <joint name="slide" type="prismatic">
    <parent link="cabinet"/><child link="drawer"/><axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.18" effort="20" velocity="0.5"/><dynamics damping="1" friction="0.1"/>
  </joint>
</robot>
