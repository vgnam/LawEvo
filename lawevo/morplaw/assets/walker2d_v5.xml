<!--
Vendored from gymnasium's walker2d_v5.xml for LawEvo MorpLaw.
Parameterized morphology fields (braced placeholders); everything else identical to upstream.

Coupling rules (must move together):
- thigh length: thigh geom halflength AND leg body offset (leg_z = -(2*thigh_len + 0.25))
- leg length: leg geom halflength AND foot body offset (foot_z = -(leg_len + 0.1))
- foot length: foot geom halflength AND foot geom center x (foot_x = -0.2 + foot_len)
-->
<mujoco model="walker2d">
  <compiler angle="degree" inertiafromgeom="true"/>
  <default>
    <joint armature="0.01" damping=".1" limited="true"/>
    <geom conaffinity="0" condim="3" contype="1" density="1000" friction=".7 .1 .1" rgba="0.8 0.6 .4 1"/>
  </default>
  <option integrator="RK4" timestep="0.002"/>
  <worldbody>
    <light cutoff="100" diffuse="1 1 1" dir="-0 0 -1.3" directional="true" exponent="1" pos="0 0 1.3" specular=".1 .1 .1"/>
    <geom conaffinity="1" condim="3" name="floor" pos="0 0 0" rgba="0.8 0.9 0.8 1" size="40 40 40" type="plane" material="MatPlane"/>
    <body name="torso" pos="0 0 1.25">
      <camera name="track" mode="trackcom" pos="0 -3 -0.25" xyaxes="1 0 0 0 0 1"/>
      <joint armature="0" axis="1 0 0" damping="0" limited="false" name="rootx" pos="0 0 -1.25" stiffness="0" type="slide"/>
      <joint armature="0" axis="0 0 1" damping="0" limited="false" name="rootz" pos="0 0 -1.25" ref="1.25" stiffness="0" type="slide"/>
      <joint armature="0" axis="0 1 0" damping="0" limited="false" name="rooty" pos="0 0 0" stiffness="0" type="hinge"/>
      <geom density="{torso_density}" friction="0.9" name="torso_geom" size="0.05 0.2" type="capsule"/>
      <body name="thigh" pos="0 0 -0.2">
        <joint axis="0 -1 0" name="thigh_joint" pos="0 0 0" range="-150 0" type="hinge"/>
        <geom density="{thigh_density}" friction="0.9" pos="0 0 -{thigh_len}" name="thigh_geom" size="0.05 {thigh_len}" type="capsule"/>
        <body name="leg" pos="0 0 {leg_z}">
          <joint axis="0 -1 0" name="leg_joint" pos="0 0 0.25" range="-150 0" type="hinge"/>
          <geom density="{leg_density}" friction="0.9" name="leg_geom" size="0.04 {leg_len}" type="capsule"/>
          <body name="foot" pos="0.2 0 {foot_z}">
            <joint axis="0 -1 0" name="foot_joint" pos="-0.2 0 0.1" range="-45 45" type="hinge"/>
            <geom density="{foot_density}" friction="1.9" pos="{foot_x} 0 0.1" quat="0.7071067811865476 0 -0.7071067811865475 0" name="foot_geom" size="0.06 {foot_len}" type="capsule"/>
          </body>
        </body>
      </body>
      <!-- copied and then replace thigh->thigh_left, leg->leg_left, foot->foot_left -->
      <body name="thigh_left" pos="0 0 -0.2">
        <joint axis="0 -1 0" name="thigh_left_joint" pos="0 0 0" range="-150 0" type="hinge"/>
        <geom density="{thigh_density}" friction="0.9" name="thigh_left_geom" rgba=".7 .3 .6 1" size="0.05 {thigh_len}" pos="0 0 -{thigh_len}" type="capsule"/>
        <body name="leg_left" pos="0 0 {leg_z}">
          <joint axis="0 -1 0" name="leg_left_joint" pos="0 0 0.25" range="-150 0" type="hinge"/>
          <geom density="{leg_density}" friction="0.9" name="leg_left_geom" rgba=".7 .3 .6 1" size="0.04 {leg_len}" type="capsule"/>
          <body name="foot_left" pos="0.2 0 {foot_z}">
            <joint axis="0 -1 0" name="foot_left_joint" pos="-0.2 0 0.1" range="-45 45" type="hinge"/>
            <geom density="{foot_density}" friction="1.9" name="foot_left_geom" rgba=".7 .3 .6 1" size="0.06 {foot_len}" pos="{foot_x} 0 0.1" type="capsule" quat="0.7071067811865476 0 -0.7071067811865475 0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <!-- <motor joint="torso_joint" ctrlrange="-100.0 100.0" isctrllimited="true"/>-->
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="{gear}" joint="thigh_joint"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="{gear}" joint="leg_joint"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="{gear}" joint="foot_joint"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="{gear}" joint="thigh_left_joint"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="{gear}" joint="leg_left_joint"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0" gear="{gear}" joint="foot_left_joint"/>
    <!-- <motor joint="finger2_rot" ctrlrange="-20.0 20.0" isctrllimited="true"/>-->
  </actuator>
    <asset>
        <texture type="skybox" builtin="gradient" rgb1=".4 .5 .6" rgb2="0 0 0"
            width="100" height="100"/>
        <texture builtin="flat" height="1278" mark="cross" markrgb="1 1 1" name="texgeom" random="0.01" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" type="cube" width="127"/>
        <texture builtin="checker" height="100" name="texplane" rgb1="0 0 0" rgb2="0.8 0.8 0.8" type="2d" width="100"/>
        <material name="MatPlane" reflectance="0.5" shininess="1" specular="1" texrepeat="60 60" texture="texplane"/>
        <material name="geom" texture="texgeom" texuniform="true"/>
    </asset>
</mujoco>
